# Copy this file to .env. SQLite supports local development before PostgreSQL
# is installed. Relative SQLite paths are resolved from the working directory.
DATABASE_URL=sqlite:///data/db.sqlite3

# When PostgreSQL is installed, create the database and user, then replace
# DATABASE_URL above with your connection URL (URL-encode special characters
# in the username and password).
# DATABASE_URL=postgresql://training:change-me@localhost:5432/training
